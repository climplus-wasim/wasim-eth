SRC = $(OBJ:%.o=%.cc)

all: ubuntu-richards-openmpi

ubuntu-richards-openmpi: $(BINPATH)wasimuzr-${VERSIONU}-openmpi

$(BINPATH)wasimuzr-${VERSIONU}-openmpi: wasimuzr-openmpi.a
	$(GCC_MPI) modapuzr.cc wasimuzr.cc wasimuzr-openmpi.a -o $(BINPATH)wasimuzr-$(VERSIONU)-openmpi -lm -fopenmp -lgomp -lmpi -lmpi_cxx -lnetcdf

wasimuzr-openmpi.a: $(OBJ)
	ar rcv wasimuzr-openmpi.a *.o
	ranlib wasimuzr-openmpi.a
	
DEPENDFILE = .depend

dep: $(SRC)
	g++ -std=c++0x  -MM $(SRC) > $(DEPENDFILE)

-include $(DEPENDFILE)

%.o: %.cc
	$(GCC_MPI) -c $< -fopenmp  

.PHONY: clean
clean:
	rm -rf $(BINPATH)wasimuzr-${VERSIONU}-openmpi $(OBJ) wasimuzr-openmpi.a

