GCC=g++ -std=c++0x  -mtune=westmere -march=westmere -O3 -D LINUX64 -D _NETCDF -D USE_NETCDF4 -I./netcdfcpp
BINPATH=./
VERSIONU=11-01-01-x86-64-pc-linux-centos64
OBJ=abfluss.o bodenmod.o cspline.o defltuzr.o etpetr.o expokorr.o gwflow.o infilt.o interzep.o irrigate.o \
meteoint.o modefuzr.o parser.o siltingup.o snowmod.o stringp.o surfrout.o teilmod.o unsatzon.o wsstream.o gifreader.o snow_canopy.o dataassim.o \
netcdfhlp.o netcdfcpp/ncAtt.o netcdfcpp/ncByte.o netcdfcpp/ncChar.o netcdfcpp/ncCheck.o netcdfcpp/ncCompoundType.o \
netcdfcpp/ncDim.o netcdfcpp/ncDouble.o netcdfcpp/ncEnumType.o netcdfcpp/ncException.o netcdfcpp/ncFile.o netcdfcpp/ncFloat.o \
netcdfcpp/ncGroup.o netcdfcpp/ncGroupAtt.o netcdfcpp/ncInt.o netcdfcpp/ncInt64.o netcdfcpp/ncOpaqueType.o netcdfcpp/ncShort.o \
netcdfcpp/ncString.o netcdfcpp/ncType.o netcdfcpp/ncUbyte.o netcdfcpp/ncUint.o netcdfcpp/ncUint64.o netcdfcpp/ncUshort.o \
netcdfcpp/ncVar.o netcdfcpp/ncVarAtt.o netcdfcpp/ncVlenType.o 

SRC = $(OBJ:%.o=%.cc)

all: richards topmodel

richards: $(BINPATH)wasimuzr-${VERSIONU}

topmodel: $(BINPATH)wasimtop-${VERSIONU}

$(BINPATH)wasimuzr-${VERSIONU}: wasimuzr.a 
	$(GCC) modapuzr.cc wasimuzr.cc wasimuzr.a -o $(BINPATH)wasimuzr-$(VERSIONU) -lm   -fopenmp -lgomp -lnetcdf
	strip wasimuzr-$(VERSIONU)

$(BINPATH)wasimtop-${VERSIONU}: wasimuzr.a 
	$(GCC) modappli.cc wasim.cc wasimuzr.a -o $(BINPATH)wasimtop-$(VERSIONU) -lm   -fopenmp -lgomp -lnetcdf
	strip wasimtop-$(VERSIONU)

wasimuzr.a: $(OBJ)
	ar rcv wasimuzr.a *.o
	ranlib wasimuzr.a

DEPENDFILE = .depend

dep: $(SRC)
	g++ -std=c++0x  -MM $(SRC) > $(DEPENDFILE)

-include $(DEPENDFILE)

%.o: %.cc
	$(GCC) -c $< -fopenmp

.PHONY: clean
clean:
	rm -rf $(BINPATH)wasimuzr-${VERSIONU} $(BINPATH)wasimtop-${VERSIONU} $(OBJ) wasimuzr.a wasimuzr-mpi.a

