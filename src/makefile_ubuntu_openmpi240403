GCC_MPI=g++ -std=c++0x -mtune=haswell -march=haswell -O3 -D OMPI_SKIP_MPICXX -D LINUX64 -D _MPI -I/usr/lib/x86_64-linux-gnu/openmpi/include -L/usr/lib/x86_64-linux-gnu/openmpi/lib -D _OMP3 -D _NETCDF -D USE_NETCDF4 -L/usr/lib/x86_64-linux-gnu -I/usr/include -I./netcdfcpp -Wno-unused-result
BINPATH=./
DISTRO=ubuntu240403
VERSIONU=11-01-01-x86-64-pc-linux-$(DISTRO)
OBJ=abfluss.o cspline.o defltuzr.o etpetr.o expokorr.o gwflow.o interzep.o irrigate.o snow_canopy.o \
meteoint.o modefuzr.o parser.o siltingup.o snowmod.o stringp.o surfrout.o teilmod.o unsatzon.o wsstream.o gifreader.o dataassim.o modapuzr.o wasimuzr.o \
netcdfhlp.o netcdfcpp/ncAtt.o netcdfcpp/ncByte.o netcdfcpp/ncChar.o netcdfcpp/ncCheck.o netcdfcpp/ncCompoundType.o \
netcdfcpp/ncDim.o netcdfcpp/ncDouble.o netcdfcpp/ncEnumType.o netcdfcpp/ncException.o netcdfcpp/ncFile.o netcdfcpp/ncFloat.o \
netcdfcpp/ncGroup.o netcdfcpp/ncGroupAtt.o netcdfcpp/ncInt.o netcdfcpp/ncInt64.o netcdfcpp/ncOpaqueType.o netcdfcpp/ncShort.o \
netcdfcpp/ncString.o netcdfcpp/ncType.o netcdfcpp/ncUbyte.o netcdfcpp/ncUint.o netcdfcpp/ncUint64.o netcdfcpp/ncUshort.o \
netcdfcpp/ncVar.o netcdfcpp/ncVarAtt.o netcdfcpp/ncVlenType.o 

SRC = $(OBJ:%.o=%.cc)

all: ubuntu-richards-openmpi

ubuntu-richards-openmpi: $(BINPATH)wasimuzr-${VERSIONU}-openmpi

$(BINPATH)wasimuzr-${VERSIONU}-openmpi: wasimuzr-openmpi-$(DISTRO).a
	$(GCC_MPI) wasimuzr-openmpi-$(DISTRO).a -o $(BINPATH)wasimuzr-$(VERSIONU)-openmpi -lm -fopenmp -lgomp -lmpi -lnetcdf
	strip wasimuzr-$(VERSIONU)-openmpi

wasimuzr-openmpi-$(DISTRO).a: $(OBJ)
	ar rcv wasimuzr-openmpi-$(DISTRO).a *.o
	ranlib wasimuzr-openmpi-$(DISTRO).a

DEPENDFILE = .depend

dep: $(SRC)
	g++ -std=c++0x  -MM $(SRC) > $(DEPENDFILE)

-include $(DEPENDFILE)

%.o: %.cc
	$(GCC_MPI) -c $< -fopenmp

.PHONY: clean
clean:
	rm -rf $(BINPATH)wasimuzr-${VERSIONU}-openmpi $(OBJ) wasimuzr-openmpi-$(DISTRO).a

